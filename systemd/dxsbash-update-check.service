[Unit]
Description=Check for DXSBash updates and notify
Documentation=https://dxsbash.digitalxs.ca
# Notifications need the desktop session (D-Bus, display)
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/bin/bash %h/linuxtoolbox/dxsbash/update-notify.sh
# The notification waits for a click, and "Update now" keeps the
# settings window inside this unit until it is closed (a background
# child would be killed with the unit's cgroup) — so no short timeout
TimeoutStartSec=12h
